# Reference only: Convex writes these values to .env.local on setup.
# Run `npm run dev` and select the existing devtreff project.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# For Vercel, set CONVEX_DEPLOY_KEY in the Vercel dashboard.
# The Vercel build command injects NEXT_PUBLIC_CONVEX_URL automatically.
# Never commit a deploy key.
